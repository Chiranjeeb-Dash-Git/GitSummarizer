NODE_ENV=development
PORT=8080

# Browser origins allowed to call the API (comma separated). Needed when frontend and backend run on different origins.
CLIENT_ORIGIN=http://localhost:5173

# Neon: pooled connection string for the app, direct (unpooled) string for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-64-random-hex-characters-generated-by-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
COOKIE_NAME=gs_session
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# GitHub (optional, raises the rate limit from 60 to 5000 requests per hour)
GITHUB_TOKEN=

# AI: choose one provider (gemini, openai, anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=1800
PROMPT_VERSION=v1
SUMMARY_TTL_HOURS=24

# Serve the built React app from this server (single-service deployment)
SERVE_CLIENT=false

LOG_LEVEL=info

# Email verification (optional; EMAIL_FROM is required in production when enabled)
RESEND_API_KEY=
EMAIL_FROM=

# Neon Auth managed session verification (optional)
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=

